# Defaults support localhost without an external account.
DATABASE_URL=postgresql+psycopg://lens:lens_local_only@127.0.0.1:55432/identity_lens
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000
SECURE_COOKIES=false
# Keep false under the hackathon's synthetic-only scope.
ALLOW_BROWSER_TELEMETRY=false
# Explicit, notice-gated hosted activity on fictional applicants only.
ALLOW_HOSTED_ACTIVITY=true
# The legacy sample sandbox is separate from organisation data.
ENABLE_SANDBOX=true
# Keep false locally. On an approved public deployment, samples become read-only.
ALLOW_PUBLIC_SAMPLES=false
# Localhost is already permitted. Configure only for a separate deployment.
PUBLIC_HOST=
# Leave empty to use the local API proxy.
VITE_API_URL=
# Email delivery and email-based password recovery are intentionally not offered.
